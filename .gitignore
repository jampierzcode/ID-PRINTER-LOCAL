# Ignorar carpetas de compilación y archivos generados por PyInstaller
build/
dist/
Id-server.spec
Id-server.py

# Logs generados en runtime
logs/

# Certificados SSL: se generan en cada PC con mkcert (ver README)
# (anclado a la raíz para no atrapar también php/cert/, que sí va versionado)
/cert/

# Archivo de entorno con URLs cloud: copiar desde .env.example
public/nprint/.env

# Basura de macOS
.DS_Store
# Bitácora local de impresiones (rastreo del POS) — cambia en cada ticket
public/nprint/data/print_jobs.sqlite*
