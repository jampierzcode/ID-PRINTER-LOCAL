# Copia este archivo como `.env` en la misma carpeta (public/nprint/.env)
# y ajusta las URLs si corresponde al ambiente del cliente.

# URL base del backend cloud (API de autenticación / POS)
CLOUD_BASE_URL="https://pos-auth-api-production.up.railway.app/api"

# URL base del frontend de facturación
FACTURACION_BASE_URL="https://front-pos-facturas.vercel.app/"

